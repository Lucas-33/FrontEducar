
BEGIN;

-- ==============================================================================
-- 0. LIMPIEZA DEL ESQUEMA (IDEMPOTENCIA)
-- ==============================================================================
DROP TABLE IF EXISTS usuario CASCADE;
DROP TABLE IF EXISTS rol CASCADE;
DROP TABLE IF EXISTS inscripcion_comedor CASCADE;
DROP TABLE IF EXISTS inscripcion_transporte CASCADE;
DROP TABLE IF EXISTS recorrido_transporte CASCADE;
DROP TABLE IF EXISTS inscripcion_deporte CASCADE;
DROP TABLE IF EXISTS grupo_deporte CASCADE;
DROP TABLE IF EXISTS horario CASCADE;
DROP TABLE IF EXISTS deporte CASCADE;
DROP TABLE IF EXISTS materia_curso_profesor CASCADE;
DROP TABLE IF EXISTS materia CASCADE;
DROP TABLE IF EXISTS padre_alumno CASCADE;
DROP TABLE IF EXISTS padre CASCADE;
DROP TABLE IF EXISTS profesor CASCADE;
DROP TABLE IF EXISTS alumno CASCADE;
DROP TABLE IF EXISTS curso CASCADE;
DROP TABLE IF EXISTS nivel_educativo CASCADE;

-- ==============================================================================
-- 1. CREACIÓN DE TABLAS (DDL)
-- ==============================================================================

CREATE TABLE nivel_educativo (
    id_nivel INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL
);

CREATE TABLE curso (
    id_curso INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    id_nivel INT NOT NULL REFERENCES nivel_educativo(id_nivel) ON DELETE RESTRICT
);

CREATE TABLE alumno (
    legajo INT PRIMARY KEY,
    dni VARCHAR(20) NOT NULL UNIQUE,
    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    fecha_nacimiento DATE NOT NULL,
    domicilio TEXT NOT NULL,
    telefono VARCHAR(50),
    correo_electronico VARCHAR(100),
    id_curso INT NOT NULL REFERENCES curso(id_curso) ON DELETE RESTRICT,
    estado_alumno VARCHAR(20) NOT NULL DEFAULT 'ACTIVO' 
        CHECK (estado_alumno IN ('ACTIVO', 'INACTIVO', 'EGRESADO', 'SUSPENDIDO'))
);

CREATE TABLE profesor (
    legajo INT PRIMARY KEY,
    dni VARCHAR(20) NOT NULL UNIQUE,
    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    especialidad VARCHAR(100) NOT NULL,
    correo_electronico VARCHAR(100) NOT NULL,
    telefono VARCHAR(50) NOT NULL,
    estado VARCHAR(20) NOT NULL DEFAULT 'ACTIVO' 
        CHECK (estado IN ('ACTIVO', 'INACTIVO', 'LICENCIA'))
);

CREATE TABLE padre (
    id_padre INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    dni VARCHAR(20) NOT NULL UNIQUE,
    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    telefono VARCHAR(50),
    correo_electronico VARCHAR(100)
);

CREATE TABLE padre_alumno (
    id_padre INT NOT NULL REFERENCES padre(id_padre) ON DELETE CASCADE,
    legajo_alumno INT NOT NULL REFERENCES alumno(legajo) ON UPDATE CASCADE ON DELETE CASCADE,
    PRIMARY KEY (id_padre, legajo_alumno)
);

CREATE TABLE materia (
    id_materia INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL
);

CREATE TABLE materia_curso_profesor (
    id_materia INT NOT NULL REFERENCES materia(id_materia) ON DELETE CASCADE,
    id_curso INT NOT NULL REFERENCES curso(id_curso) ON DELETE CASCADE,
    legajo_profesor INT NOT NULL REFERENCES profesor(legajo) ON UPDATE CASCADE ON DELETE RESTRICT,
    PRIMARY KEY (id_materia, id_curso)
);

CREATE TABLE deporte (
    id_deporte INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    legajo_profesor_responsable INT REFERENCES profesor(legajo) ON UPDATE CASCADE ON DELETE SET NULL
);

CREATE TABLE horario (
    id_horario INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    descripcion VARCHAR(100) NOT NULL
);

CREATE TABLE grupo_deporte (
    id_grupo INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    id_deporte INT NOT NULL REFERENCES deporte(id_deporte) ON DELETE CASCADE,
    id_nivel INT NOT NULL REFERENCES nivel_educativo(id_nivel) ON DELETE RESTRICT,
    id_horario INT NOT NULL REFERENCES horario(id_horario) ON DELETE RESTRICT
);

CREATE TABLE inscripcion_deporte (
    legajo_alumno INT NOT NULL REFERENCES alumno(legajo) ON UPDATE CASCADE ON DELETE CASCADE,
    id_grupo INT NOT NULL REFERENCES grupo_deporte(id_grupo) ON DELETE CASCADE,
    fecha_inscripcion DATE NOT NULL DEFAULT CURRENT_DATE,
    PRIMARY KEY (legajo_alumno, id_grupo)
);

CREATE TABLE recorrido_transporte (
    id_recorrido INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    descripcion VARCHAR(100) NOT NULL
);

CREATE TABLE inscripcion_transporte (
    legajo_alumno INT PRIMARY KEY REFERENCES alumno(legajo) ON UPDATE CASCADE ON DELETE CASCADE,
    id_recorrido INT NOT NULL REFERENCES recorrido_transporte(id_recorrido) ON DELETE RESTRICT,
    fecha_alta DATE NOT NULL DEFAULT CURRENT_DATE,
    estado VARCHAR(20) NOT NULL DEFAULT 'ACTIVO' 
        CHECK (estado IN ('ACTIVO', 'INACTIVO', 'SUSPENDIDO'))
);

CREATE TABLE inscripcion_comedor (
    legajo_alumno INT PRIMARY KEY REFERENCES alumno(legajo) ON UPDATE CASCADE ON DELETE CASCADE,
    fecha_alta DATE NOT NULL DEFAULT CURRENT_DATE,
    estado VARCHAR(20) NOT NULL DEFAULT 'ACTIVO' 
        CHECK (estado IN ('ACTIVO', 'INACTIVO', 'SUSPENDIDO'))
);

CREATE TABLE rol (
    id_rol INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL UNIQUE 
        CHECK (nombre IN ('ADMIN', 'TEACHER', 'PARENT', 'STUDENT'))
);

CREATE TABLE usuario (
    id_usuario INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    username VARCHAR(50) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    id_rol INT NOT NULL REFERENCES rol(id_rol) ON DELETE RESTRICT,
    legajo_alumno INT REFERENCES alumno(legajo) ON UPDATE CASCADE ON DELETE SET NULL,
    legajo_profesor INT REFERENCES profesor(legajo) ON UPDATE CASCADE ON DELETE SET NULL,
    id_padre INT REFERENCES padre(id_padre) ON DELETE SET NULL,
    activo BOOLEAN NOT NULL DEFAULT TRUE,
    creado_en TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- ==============================================================================
-- 2. CREACIÓN DE ÍNDICES PARA OPTIMIZACIÓN DE BÚSQUEDAS Y JOINS
-- ==============================================================================

-- Índices para búsqueda frecuente
CREATE INDEX idx_alumno_dni ON alumno(dni);
CREATE INDEX idx_alumno_apellido ON alumno(apellido);
CREATE INDEX idx_profesor_dni ON profesor(dni);
CREATE INDEX idx_profesor_apellido ON profesor(apellido);
CREATE INDEX idx_padre_dni ON padre(dni);
CREATE INDEX idx_padre_apellido ON padre(apellido);

-- Índices de Claves Foráneas (optimizan operaciones JOIN, ON DELETE y ON UPDATE)
CREATE INDEX idx_curso_nivel ON curso(id_nivel);
CREATE INDEX idx_alumno_curso ON alumno(id_curso);
CREATE INDEX idx_padre_alumno_legajo ON padre_alumno(legajo_alumno);
CREATE INDEX idx_mcp_profesor ON materia_curso_profesor(legajo_profesor);
CREATE INDEX idx_deporte_prof_resp ON deporte(legajo_profesor_responsable);
CREATE INDEX idx_grupo_deporte_deporte ON grupo_deporte(id_deporte);
CREATE INDEX idx_grupo_deporte_nivel ON grupo_deporte(id_nivel);
CREATE INDEX idx_grupo_deporte_horario ON grupo_deporte(id_horario);
CREATE INDEX idx_ins_deporte_grupo ON inscripcion_deporte(id_grupo);
CREATE INDEX idx_ins_transporte_recorrido ON inscripcion_transporte(id_recorrido);
CREATE INDEX idx_usuario_rol ON usuario(id_rol);
CREATE INDEX idx_usuario_alumno ON usuario(legajo_alumno);
CREATE INDEX idx_usuario_profesor ON usuario(legajo_profesor);
CREATE INDEX idx_usuario_padre ON usuario(id_padre);

-- ==============================================================================
-- 3. COMENTARIOS DESCRIPTIVOS Y DOCUMENTACIÓN EN BD
-- ==============================================================================

COMMENT ON TABLE alumno IS 'Entidad principal para los estudiantes del centro educativo';
COMMENT ON COLUMN alumno.legajo IS 'Identificador único (entero) del alumno';
COMMENT ON COLUMN alumno.id_curso IS 'Referencia obligatoria al curso, del cual se deduce implícitamente el nivel educativo (3FN)';

COMMENT ON TABLE profesor IS 'Registro del personal docente';
COMMENT ON TABLE padre IS 'Información de contacto e identidad de los tutores';

COMMENT ON TABLE usuario IS 'Control de acceso al sistema aplicando RBAC (Role-Based Access Control)';
COMMENT ON COLUMN usuario.legajo_alumno IS 'Vínculo opcional si el usuario pertenece a un estudiante';
COMMENT ON COLUMN usuario.legajo_profesor IS 'Vínculo opcional si el usuario pertenece a un docente';
COMMENT ON COLUMN usuario.id_padre IS 'Vínculo opcional si el usuario pertenece a un tutor';

COMMIT;