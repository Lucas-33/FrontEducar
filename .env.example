# ============================================================
# Plantilla de configuración del backend
# Copiar a `.env` y ajustar los valores según el entorno.
# ============================================================

# Conexión a PostgreSQL (postgresql+psycopg2://usuario:clave@host:puerto/base)
# En Neon copiá la cadena de conexión "Pooled connection"; por ejemplo:
# DATABASE_URL=postgresql://usuario:clave@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/educar_db

# Clave para firmar los tokens JWT (generar una propia en producción)
SECRET_KEY=cambiar_esta_clave_por_una_segura

# Duración del token en minutos (24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Opcionales en producción (Render) ---
# Normalmente NO hace falta definirlas: la app usa el puerto local asignado
# por Render y agrega RENDER_EXTERNAL_URL a CORS automáticamente.
# API_BASE_URL=https://mi-servicio.onrender.com/api/v1
# CORS_ORIGINS=https://mi-servicio.onrender.com,https://otro-dominio.com
