# ============================================================
# Plantilla de configuración del backend
# Copiar a `.env` y ajustar los valores según el entorno.
# ============================================================

# Conexión a PostgreSQL (postgresql+psycopg2://usuario:clave@host:puerto/base)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/educar_db

# Clave para firmar los tokens JWT (generar una propia en producción)
SECRET_KEY=cambiar_esta_clave_por_una_segura

# Duración del token en minutos (24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
